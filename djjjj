AWSTemplateFormatVersion: '2010-09-09'
Description: Deploy jBPM on ECS Fargate with EFS storage

Parameters:

  VpcId:
    Type: AWS::EC2::VPC::Id

  PublicSubnets:
    Type: List<AWS::EC2::Subnet::Id>

  PrivateSubnets:
    Type: List<AWS::EC2::Subnet::Id>

  ContainerImage:
    Type: String
    Default: jbpm/jbpm-server-full:latest

  DesiredCount:
    Type: Number
    Default: 1

Resources:

########################################
# EFS
########################################

  JBPMFileSystem:
    Type: AWS::EFS::FileSystem
    Properties:
      Encrypted: true
      PerformanceMode: generalPurpose
      LifecyclePolicies:
        - TransitionToIA: AFTER_30_DAYS

  JBPMMountTarget1:
    Type: AWS::EFS::MountTarget
    Properties:
      FileSystemId: !Ref JBPMFileSystem
      SubnetId: !Select [0, !Ref PrivateSubnets]
      SecurityGroups:
        - !Ref EFSSecurityGroup

  JBPMMountTarget2:
    Type: AWS::EFS::MountTarget
    Properties:
      FileSystemId: !Ref JBPMFileSystem
      SubnetId: !Select [1, !Ref PrivateSubnets]
      SecurityGroups:
        - !Ref EFSSecurityGroup

########################################
# Security Groups
########################################

  ALBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Allow HTTP
      VpcId: !Ref VpcId
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 80
          ToPort: 80
          CidrIp: 0.0.0.0/0

  ServiceSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Allow traffic from ALB
      VpcId: !Ref VpcId
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 8080
          ToPort: 8080
          SourceSecurityGroupId: !Ref ALBSecurityGroup

  EFSSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Allow NFS from ECS
      VpcId: !Ref VpcId
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 2049
          ToPort: 2049
          SourceSecurityGroupId: !Ref ServiceSecurityGroup

########################################
# ECS Cluster
########################################

  JBPMCluster:
    Type: AWS::ECS::Cluster

########################################
# IAM Role for ECS Task
########################################

  ECSTaskExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: ecs-tasks.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy

########################################
# Task Definition
########################################

  JBPMTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: jbpm-task
      RequiresCompatibilities:
        - FARGATE
      Cpu: 1024
      Memory: 2048
      NetworkMode: awsvpc
      ExecutionRoleArn: !GetAtt ECSTaskExecutionRole.Arn
      ContainerDefinitions:
        - Name: jbpm
          Image: !Ref ContainerImage
          PortMappings:
            - ContainerPort: 8080
          Essential: true
          MountPoints:
            - SourceVolume: jbpm-data
              ContainerPath: /opt/jboss/wildfly/standalone/data
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: /ecs/jbpm
              awslogs-region: !Ref AWS::Region
              awslogs-stream-prefix: ecs

      Volumes:
        - Name: jbpm-data
          EFSVolumeConfiguration:
            FilesystemId: !Ref JBPMFileSystem
            TransitEncryption: ENABLED

########################################
# Load Balancer
########################################

  JBPMALB:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Subnets: !Ref PublicSubnets
      SecurityGroups:
        - !Ref ALBSecurityGroup
      Scheme: internet-facing
      Type: application

  JBPMTargetGroup:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Port: 8080
      Protocol: HTTP
      VpcId: !Ref VpcId
      TargetType: ip
      HealthCheckPath: /

  JBPMListener:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      LoadBalancerArn: !Ref JBPMALB
      Port: 80
      Protocol: HTTP
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref JBPMTargetGroup

  JBPMInternalALB:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Subnets: !Ref PrivateSubnets
      SecurityGroups:
        - !Ref ServiceSecurityGroup
      Scheme: internal
      Type: application

  JBPMInternalTargetGroup:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Port: 8080
      Protocol: HTTP
      VpcId: !Ref VpcId
      TargetType: ip
      HealthCheckPath: /

  JBPMInternalListener:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      LoadBalancerArn: !Ref JBPMInternalALB
      Port: 80
      Protocol: HTTP
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref JBPMInternalTargetGroup

########################################
# ECS Service
########################################

  JBPMService:
    Type: AWS::ECS::Service
    DependsOn: JBPMListener
    Properties:
      Cluster: !Ref JBPMCluster
      LaunchType: FARGATE
      DesiredCount: !Ref DesiredCount
      TaskDefinition: !Ref JBPMTaskDefinition
      NetworkConfiguration:
        AwsvpcConfiguration:
          AssignPublicIp: DISABLED
          Subnets: !Ref PrivateSubnets
          SecurityGroups:
            - !Ref ServiceSecurityGroup
      LoadBalancers:
        - ContainerName: jbpm
          ContainerPort: 8080
          TargetGroupArn: !Ref JBPMTargetGroup

Outputs:

  ALBURL:
    Description: Access URL
    Value: !Sub "http://${JBPMALB.DNSName}"

